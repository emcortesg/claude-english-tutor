{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso-ingles/contracts/profile.schema.json",
  "title": "profile.json",
  "description": "Learner profile. Written by engine.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "name",
    "started_on",
    "recording_consent"
  ],
  "properties": {
    "student_id": {
      "$ref": "#/$defs/studentId"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "started_on": {
      "$ref": "#/$defs/date"
    },
    "placement_level": {
      "$ref": "#/$defs/level"
    },
    "start_lesson": {
      "$ref": "#/$defs/lessonId"
    },
    "recording_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given",
        "date"
      ],
      "properties": {
        "given": {
          "type": "boolean"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "text_version": {
          "type": "string"
        }
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state_rev": {
      "type": "integer",
      "minimum": 0,
      "description": "Engine write counter; all files written by the same command carry the same value"
    }
  },
  "$defs": {
    "lessonId": {
      "type": "string",
      "pattern": "^L\\d{3}$"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "section": {
      "type": "string",
      "pattern": "^\\d\\.\\d+a?$"
    },
    "studentId": {
      "type": "string",
      "pattern": "^student-\\d{4}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^S\\d{4,}$"
    },
    "eventId": {
      "type": "string",
      "description": "Lesson ID (lesson assessment), Check ID (ULC-…), exit ID (EXIT-…), or PLACEMENT",
      "pattern": "^(L\\d{3}|ULC-[A-C][12]-U\\d{2}R?|EXIT-[A-C][12]|PLACEMENT)$"
    },
    "dimension": {
      "enum": [
        "Reading",
        "Writing",
        "Speaking",
        "Listening",
        "Grammar",
        "Vocabulary"
      ]
    },
    "band": {
      "enum": [
        0,
        25,
        50,
        75,
        100
      ]
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "resourceRef": {
      "type": "object",
      "required": [
        "resource_id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "audio",
            "prompt"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}