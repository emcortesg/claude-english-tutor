{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso-ingles/contracts/voice_brief.schema.json",
  "title": "Voice agent brief",
  "description": "Written by the tutor to voice-sessions/<session_id>/brief.json; read by the voice page. agent_instructions, written by the tutor for this lesson, is what Gemini Live receives as its instructions (the page only adds a fixed technical block: turns, ending, report).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "session_id",
    "student_id",
    "created_at",
    "mode",
    "lesson_id",
    "level",
    "visible_to_learner",
    "agent_instructions",
    "hidden_objectives",
    "target_grammar",
    "priority_vocabulary",
    "pronunciation_focus",
    "end_condition",
    "shared_text",
    "character_gender"
  ],
  "properties": {
    "contract": {
      "const": "voice_brief/3"
    },
    "session_id": {
      "$ref": "#/$defs/sessionId"
    },
    "student_id": {
      "$ref": "#/$defs/studentId"
    },
    "created_at": {
      "$ref": "#/$defs/datetime"
    },
    "mode": {
      "enum": [
        "practice",
        "exam"
      ]
    },
    "lesson_id": {
      "$ref": "#/$defs/lessonId"
    },
    "level": {
      "$ref": "#/$defs/level"
    },
    "event_id": {
      "$ref": "#/$defs/eventId"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "visible_to_learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation"
      ],
      "properties": {
        "situation": {
          "type": "string",
          "description": "The only part the page shows to the learner"
        }
      }
    },
    "agent_instructions": {
      "type": "string",
      "minLength": 300,
      "maxLength": 6000,
      "description": "Instructions for Gemini Live written by the tutor for this lesson and learner, in English (references/voice.md › agent_instructions)"
    },
    "pictures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "Optional picture specs for scripts/picture.py (1–3); the page shows the drawings under the situation",
      "items": {
        "type": "object",
        "required": [
          "template"
        ],
        "properties": {
          "template": {
            "enum": [
              "people",
              "home",
              "schedule",
              "board",
              "card",
              "icons",
              "drawing"
            ]
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "character_gender": {
      "enum": [
        "female",
        "male"
      ],
      "description": "Gender of the character Gemini plays; the voice page picks a matching Gemini voice"
    },
    "shared_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "body"
      ],
      "description": "Required in every voice session (practice and exam): a short new text that Gemini reads aloud at the start; the conversation is only about it (references/voice.md › Text + conversation)",
      "properties": {
        "kind": {
          "enum": [
            "news",
            "article",
            "story",
            "lesson"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 150,
          "maxLength": 2200
        },
        "resource_id": {
          "type": "string",
          "pattern": "^TXT-L\\d{3}-[A-Za-z0-9-]+$"
        }
      }
    },
    "picture_waived_reason": {
      "type": "string",
      "minLength": 15,
      "description": "A1–A2 only: why this conversation has no picture (required when pictures is absent)"
    },
    "hidden_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "target_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "focus"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "minItems": 1
        },
        "focus": {
          "type": "string"
        },
        "target_uses": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "priority_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pronunciation_focus": {
      "type": "string"
    },
    "pronunciation_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "description": "Words that carry the pronunciation focus (e.g. [\"mustn't\"]); the page marks the learner turns that contain them so that Gemini writes a focused note"
    },
    "learner_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tutor input (errors seen today, interests)"
    },
    "end_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_minutes"
      ],
      "properties": {
        "target_learner_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "resource": {
      "$ref": "#/$defs/resourceRef"
    }
  },
  "$defs": {
    "lessonId": {
      "type": "string",
      "pattern": "^L\\d{3}$"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "section": {
      "type": "string",
      "pattern": "^\\d\\.\\d+a?$"
    },
    "studentId": {
      "type": "string",
      "pattern": "^student-\\d{4}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^S\\d{4,}$"
    },
    "eventId": {
      "type": "string",
      "description": "Lesson ID (lesson assessment), Check ID (ULC-…), exit ID (EXIT-…), or PLACEMENT",
      "pattern": "^(L\\d{3}|ULC-[A-C][12]-U\\d{2}R?|EXIT-[A-C][12]|PLACEMENT)$"
    },
    "dimension": {
      "enum": [
        "Reading",
        "Writing",
        "Speaking",
        "Listening",
        "Grammar",
        "Vocabulary"
      ]
    },
    "band": {
      "enum": [
        0,
        25,
        50,
        75,
        100
      ]
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "resourceRef": {
      "type": "object",
      "required": [
        "resource_id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "audio",
            "prompt"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "exam"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "attempt"
        ]
      }
    }
  ]
}